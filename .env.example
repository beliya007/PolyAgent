# ============================================================
# Agent 服务环境变量配置
# ============================================================

# ---- LLM 基础配置 (OpenAI 兼容接口) ----
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_ID=qwen-plus
LLM_TIMEOUT=60

# ---- Java 后端地址(可选,默认走 Mock) ----
# JAVA_BACKEND_URL=http://localhost:8080

# ============================================================
# 推荐 Provider 配置
# ============================================================

# 通义千问(Qwen,推荐国内)
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL_ID=qwen-plus

# OpenAI
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_ID=gpt-4o-mini

# Ollama 本地
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL_ID=qwen2.5:7b

# ============================================================
# 嵌入服务(第八章 记忆与检索)
# ============================================================
# auto | dashscope | local | tfidf
EMBED_PREFER=auto
# EMBED_MODEL_NAME=text-embedding-v3
# EMBED_BASE_URL=
# EMBED_API_KEY=
EMBED_DIM=1024
# EMBED_LOCAL_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ============================================================
# 记忆系统 - 存储后端开关
# ============================================================
# 向量后端:memory(默认,零依赖) / qdrant
VECTOR_BACKEND=memory
# QDRANT_URL=https://xxx.qdrant.tech:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=polyagent_vectors
QDRANT_VECTOR_SIZE=1024
QDRANT_DISTANCE=cosine
QDRANT_TIMEOUT=30

# 图后端:memory(默认) / neo4j
GRAPH_BACKEND=memory
# NEO4J_URI=neo4j+s://xxx.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_LIFETIME=3600
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=60

# 文档后端:memory(默认) / sqlite
DOC_BACKEND=memory
MEMORY_SQLITE_PATH=./data/memory/memory.db

# ============================================================
# 记忆系统 - 容量 / TTL
# ============================================================
WORKING_MEMORY_CAPACITY=50
WORKING_MEMORY_TTL=60
WORKING_MEMORY_TTL_SECONDS=3600
EPISODIC_CAPACITY=5000
SEMANTIC_CAPACITY=5000
PERCEPTUAL_CAPACITY=1000
MEMORY_SEARCH_LIMIT=5
MEMORY_SCORE_THRESHOLD=0.0
MEMORY_ENABLE_JSONL=false
MEMORY_STORAGE_PATH=./data/memory
